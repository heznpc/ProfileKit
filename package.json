{
  "name": "profilekit",
  "version": "1.0.0",
  "private": true,
  "description": "Cards for your GitHub README. 28 composable SVG card endpoints, every visual property exposed as a query parameter. No ratings, no rankings.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "npm run check",
    "smoke:server": "node scripts/server-smoke.js",
    "pack:check": "node scripts/pack-check.js",
    "check": "node --check server.js && find api src scripts -name '*.js' -exec node --check {} +"
  },
  "files": [
    "api/",
    "src/",
    "public/",
    "examples/self-host/",
    "server.js",
    "vercel.json",
    "Dockerfile",
    ".dockerignore"
  ],
  "license": "MIT",
  "devDependencies": {
    "license-checker-evergreen": "^6.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heznpc/ProfileKit.git"
  },
  "homepage": "https://github.com/heznpc/ProfileKit#readme",
  "bugs": {
    "url": "https://github.com/heznpc/ProfileKit/issues"
  }
}
