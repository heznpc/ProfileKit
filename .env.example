# Copy this file to .env; npm start loads it automatically.
# Existing shell environment variables take precedence. Never commit .env.
PORT=3000

# GitHub token(s) used by all /api/* endpoints that hit the GitHub API
# (stats, languages, pin, reviews, stack).
#
# A single token bottlenecks at 5000 GraphQL points per hour — that's
# roughly 1000 stats calls per hour in the worst case. Heavy readers
# (popular README embeds) blow through this in minutes. If you're
# self-hosting, set up a token pool. src/common/github-token.js reads
# any of the three shapes below; duplicates across them are removed,
# so you can mix and match.
#
# A token needs the `public_repo` scope (or nothing at all for public
# stats — fine-grained "no access" tokens still count against your
# hourly budget and are the recommended minimum).

# --- Option A: single token (simplest) ---
GITHUB_TOKEN=

# --- Option B: comma-separated pool ---
# GITHUB_TOKENS=TOKEN_A,TOKEN_B,TOKEN_C

# --- Option C: numbered pool (GITHUB_TOKEN_1..GITHUB_TOKEN_31) ---
# GITHUB_TOKEN_1=TOKEN_A
# GITHUB_TOKEN_2=TOKEN_B
# GITHUB_TOKEN_3=TOKEN_C

# Optional shared gallery. Leave unset to keep publishing disabled.
# Choose ONE storage backend. Keep local gallery data outside this repository.
# For local/self-host use, set an absolute path to a durable directory:
# PROFILEKIT_GALLERY_DIR=/absolute/path/to/profilekit-gallery
# For Supabase, apply examples/self-host/gallery.sql and configure BOTH values:
# PROFILEKIT_GALLERY_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# PROFILEKIT_GALLERY_SUPABASE_SERVICE_KEY=

# Set the exact browser origin for the configured gallery deployment.
# PROFILEKIT_PUBLIC_ORIGIN=http://localhost:3000
# Optional private key required for publishing to this gallery:
# PROFILEKIT_GALLERY_PUBLISH_KEY=

# AI edits use the API key and model entered in the editor for each request.
# There is no server-side AI key to configure here.
